generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum EstadoBase {
  LISTA_PARA_LIMPIAR
  LISTA_PARA_ENRIQUECER
  LISTA_PARA_DISTRIBUIR
}

enum TipificacionRegistro {
  PENDIENTE
  VALIDO
  TELEFONO_VACIO
  TELEFONO_FIJO
  TELEFONO_INVALIDO
  NOMBRE_VACIO
  TELEFONO_DUPLICADO
}

enum Campana {
  YOIGO
  VODAFONE
}

enum AccionAuditoria {
  BASE_CREADA
  BASE_RECICLADA
  ENRIQUECIMIENTO_APLICADO
  CONFIGURACION_CAMPANA
  LOTES_CREADOS
  EXPORTACION_GENERADA
  DESCARGA_INICIADA
  ENTREGA_CONFIRMADA
}

enum EstadoExportacion {
  GENERADO
  DESCARGA_INICIADA
  ENTREGADO_CONFIRMADO
}

model Base {
  id                  String     @id @default(uuid()) @db.Uuid
  nombreOriginal      String     @map("nombre_original")
  creadoEn            DateTime   @default(now()) @map("creado_en")
  actualizadoEn       DateTime   @updatedAt @map("actualizado_en")
  estado              EstadoBase @default(LISTA_PARA_LIMPIAR)
  cantidadImportados  Int        @default(0) @map("cantidad_importados")
  cantidadValidos     Int        @default(0) @map("cantidad_validos")
  cantidadExcluidos   Int        @default(0) @map("cantidad_excluidos")
  metadatos           Json
  registros           Registro[]
  lotes               Lote[]
  eventosAuditoria    EventoAuditoria[]
  exportaciones       RegistroExportacion[]

  @@index([estado])
  @@map("bases")
}

model Registro {
  id                  String                @id @default(uuid()) @db.Uuid
  baseId              String                @map("base_id") @db.Uuid
  numeroFilaOriginal  Int                   @map("numero_fila_original")
  movilNormalizado    String?               @map("movil_normalizado")
  documento           String?
  nombre              String?
  operadorActual      String?               @map("operador_actual")
  operadorOriginal    String?               @map("operador_original")
  fechaPortabilidad   DateTime?             @map("fecha_portabilidad") @db.Date
  tipificacion        TipificacionRegistro  @default(PENDIENTE)
  datosOriginales     Json                  @map("datos_originales")
  creadoEn            DateTime              @default(now()) @map("creado_en")
  base                Base                  @relation(fields: [baseId], references: [id], onDelete: Cascade)
  lotes               LoteRegistro[]

  @@unique([baseId, numeroFilaOriginal])
  @@index([baseId])
  @@index([baseId, movilNormalizado])
  @@index([baseId, tipificacion])
  @@map("registros")
}

model Lote {
  id                  String         @id @default(uuid()) @db.Uuid
  baseId              String         @map("base_id") @db.Uuid
  campana             Campana
  numeroLote          Int            @map("numero_lote")
  cantidadRegistros   Int            @default(0) @map("cantidad_registros")
  creadoEn            DateTime       @default(now()) @map("creado_en")
  base                Base           @relation(fields: [baseId], references: [id], onDelete: Cascade)
  registros           LoteRegistro[]

  @@unique([baseId, campana, numeroLote])
  @@index([baseId])
  @@map("lotes")
}

model LoteRegistro {
  loteId              String    @map("lote_id") @db.Uuid
  registroId          String    @map("registro_id") @db.Uuid
  creadoEn            DateTime  @default(now()) @map("creado_en")
  lote                Lote      @relation(fields: [loteId], references: [id], onDelete: Cascade)
  registro            Registro  @relation(fields: [registroId], references: [id], onDelete: Cascade)

  @@id([loteId, registroId])
  @@index([registroId])
  @@map("lote_registros")
}

model Usuario {
  id           String   @id @default(uuid()) @db.Uuid
  username     String   @unique
  passwordHash String   @map("password_hash")
  activo       Boolean  @default(true)
  createdAt    DateTime @default(now()) @map("created_at")
  eventosAuditoria EventoAuditoria[]
  exportaciones RegistroExportacion[]

  @@map("usuarios")
}

model EventoAuditoria {
  id           String           @id @default(uuid()) @db.Uuid
  operacionId  String           @unique @map("operacion_id")
  creadoEn     DateTime         @default(now()) @map("creado_en")
  accion       AccionAuditoria
  usuarioId    String           @map("usuario_id") @db.Uuid
  baseId       String           @map("base_id") @db.Uuid
  loteId       String?          @map("lote_id") @db.Uuid
  campana      Campana?
  cantidad     Int?
  metadatos    Json
  usuario      Usuario          @relation(fields: [usuarioId], references: [id], onDelete: Restrict)
  base         Base             @relation(fields: [baseId], references: [id], onDelete: Restrict)

  @@index([baseId, creadoEn])
  @@index([usuarioId, creadoEn])
  @@index([campana, creadoEn])
  @@index([accion, creadoEn])
  @@map("eventos_auditoria")
}

model RegistroExportacion {
  id                    String             @id @default(uuid()) @db.Uuid
  operacionId           String             @unique @map("operacion_id")
  creadoEn              DateTime           @default(now()) @map("creado_en")
  usuarioId             String             @map("usuario_id") @db.Uuid
  baseId                String             @map("base_id") @db.Uuid
  loteId                String?            @map("lote_id") @db.Uuid
  numeroLote            Int?               @map("numero_lote")
  campana               Campana?
  tipo                  String
  estado                EstadoExportacion  @default(GENERADO)
  cantidad              Int
  filtros               Json
  metadatos             Json
  destinatario          String?
  descargaIniciadaEn    DateTime?          @map("descarga_iniciada_en")
  entregaConfirmadaEn   DateTime?          @map("entrega_confirmada_en")
  usuario               Usuario            @relation(fields: [usuarioId], references: [id], onDelete: Restrict)
  base                  Base               @relation(fields: [baseId], references: [id], onDelete: Restrict)

  @@index([baseId, creadoEn])
  @@index([campana, creadoEn])
  @@index([estado, creadoEn])
  @@map("registros_exportacion")
}
