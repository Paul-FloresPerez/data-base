generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum EstadoBase {
  LISTA_PARA_LIMPIAR
  LISTA_PARA_ENRIQUECER
  LISTA_PARA_DISTRIBUIR
}

enum TipificacionRegistro {
  PENDIENTE
  VALIDO
  TELEFONO_VACIO
  TELEFONO_FIJO
  TELEFONO_INVALIDO
  NOMBRE_VACIO
  TELEFONO_DUPLICADO
}

enum Campana {
  YOIGO
  VODAFONE
}

enum AccionAuditoria {
  BASE_CREADA
  BASE_RECICLADA
  ENRIQUECIMIENTO_APLICADO
  CONFIGURACION_CAMPANA
  LOTES_CREADOS
  EXPORTACION_GENERADA
  DESCARGA_INICIADA
  ENTREGA_CONFIRMADA
  RESERVAS_CREADAS
  RESERVA_LIBERADA
  BASE_ARCHIVADA
  BASE_RESTAURADA
}

enum EstadoExportacion {
  GENERADO
  DESCARGA_INICIADA
  ENTREGADO_CONFIRMADO
}

enum TipoBase {
  ORIGINAL
  RECICLADA
}

enum EstadoEjecucionReciclaje {
  PREPARADA
  EVALUANDO
  EVALUADA
  BASE_GENERADA
  ERROR
}

enum EstadoResultadoReciclaje {
  ELEGIBLE
  BLOQUEADO_VENTA
  REVISION_GESTION
  REVISION_CONFLICTO
  REVISION_PERMANENCIA
  FUERA_RANGO_HISTORICO
}

enum EstadoVentaExterna {
  CONFIRMADA
  AMBIGUA
  NO_CONFIRMADA
  CORREGIDA
}

enum EstadoReservaComercial {
  ACTIVA
  LIBERADA
}

enum EstadoEjecucionReciclajeGlobal {
  PREPARADA
  EVALUANDO
  EVALUADA
  ERROR
}

enum DecisionReciclajeGlobal {
  ELEGIBLE
  EXCLUIDO
  REVISION
  BLOQUEADO
}

/// RECUPERABLE denotes a lease expiry or a retryable worker failure.
enum EstadoTrabajoProcesamiento {
  PENDIENTE
  EN_PROCESO
  RECUPERABLE
  COMPLETADO
  FALLIDO
  CANCELADO
}

/// The durable work core is generic; it does not enable these engines yet.
enum TipoTrabajoProcesamiento {
  IMPORTACION
  CONCILIACION
  RECICLAJE
  EXPORTACION
}

model Base {
  id                  String     @id @default(uuid()) @db.Uuid
  codigo              String     @unique
  nombreOriginal      String     @map("nombre_original")
  nombreDescriptivo   String     @map("nombre_descriptivo")
  fechaRecepcion      DateTime?  @map("fecha_recepcion") @db.Date
  tipo                TipoBase   @default(ORIGINAL)
  baseOriginalId      String?    @map("base_original_id") @db.Uuid
  creadoEn            DateTime   @default(now()) @map("creado_en")
  actualizadoEn       DateTime   @updatedAt @map("actualizado_en")
  estado              EstadoBase @default(LISTA_PARA_LIMPIAR)
  cantidadImportados  Int        @default(0) @map("cantidad_importados")
  cantidadValidos     Int        @default(0) @map("cantidad_validos")
  cantidadExcluidos   Int        @default(0) @map("cantidad_excluidos")
  metadatos           Json
  archivadaEn         DateTime?  @map("archivada_en")
  archivadaPorUsuarioId String?  @map("archivada_por_usuario_id") @db.Uuid
  motivoArchivado     String?    @map("motivo_archivado")
  registros           Registro[]
  baseOriginal        Base?      @relation("BaseOriginal", fields: [baseOriginalId], references: [id], onDelete: Restrict)
  basesDerivadas      Base[]     @relation("BaseOriginal")
  lotes               Lote[]     @relation("LoteBase")
  lotesComoOriginal   Lote[]     @relation("LoteBaseOriginal")
  archivosTipificaciones ArchivoTipificaciones[]
  asociacionesArchivosCrm ArchivoCrmBase[] @relation("ArchivoCrmBaseOriginal")
  ejecucionesReciclajeGlobal EjecucionReciclajeGlobalBase[]
  ejecucionGlobalGeneradora EjecucionReciclajeGlobal? @relation("BaseRecicladaGlobal")
  ejecucionesReciclaje EjecucionReciclaje[]
  ejecucionGeneradora EjecucionReciclaje? @relation("BaseReciclada")
  gestionesTipificacion GestionTipificacion[]
  eventosAuditoria    EventoAuditoria[]
  exportaciones       RegistroExportacion[]
  aprobacionesHlr     AprobacionHlr[]
  destinosHlr         ConsultaHlrRegistro[]
  reservasComerciales ReservaComercial[]
  trabajosProcesamiento TrabajoProcesamiento[]
  archivadaPor         Usuario?  @relation("BaseArchivador", fields: [archivadaPorUsuarioId], references: [id], onDelete: Restrict)

  @@index([estado])
  @@index([tipo, fechaRecepcion])
  @@index([baseOriginalId])
  @@index([archivadaEn])
  @@map("bases")
}

model Registro {
  id                  String                @id @default(uuid()) @db.Uuid
  baseId              String                @map("base_id") @db.Uuid
  numeroFilaOriginal  Int                   @map("numero_fila_original")
  movilNormalizado    String?               @map("movil_normalizado")
  documento           String?
  nombre              String?
  operadorActual      String?               @map("operador_actual")
  operadorOriginal    String?               @map("operador_original")
  fechaPortabilidad   DateTime?             @map("fecha_portabilidad") @db.Date
  tipificacion        TipificacionRegistro  @default(PENDIENTE)
  datosOriginales     Json                  @map("datos_originales")
  creadoEn            DateTime              @default(now()) @map("creado_en")
  base                Base                  @relation(fields: [baseId], references: [id], onDelete: Cascade)
  lotes               LoteRegistro[]
  destinosHlr         ConsultaHlrRegistro[]
  resultadosReciclaje ResultadoEjecucionReciclaje[]

  @@unique([baseId, numeroFilaOriginal])
  @@index([baseId])
  @@index([baseId, movilNormalizado])
  @@index([movilNormalizado])
  @@index([baseId, tipificacion])
  @@map("registros")
}

model Lote {
  id                  String         @id @default(uuid()) @db.Uuid
  baseId              String         @map("base_id") @db.Uuid
  baseOriginalId      String?        @map("base_original_id") @db.Uuid
  campana             Campana
  numeroLote          Int            @map("numero_lote")
  cantidadRegistros   Int            @default(0) @map("cantidad_registros")
  creadoEn            DateTime       @default(now()) @map("creado_en")
  base                Base           @relation("LoteBase", fields: [baseId], references: [id], onDelete: Cascade)
  baseOriginal        Base?          @relation("LoteBaseOriginal", fields: [baseOriginalId], references: [id], onDelete: Restrict)
  registros           LoteRegistro[]
  reservasComerciales ReservaComercial[]

  @@unique([baseId, campana, numeroLote])
  @@index([baseId])
  @@index([baseOriginalId])
  @@map("lotes")
}

/// Durable monthly sequence used only to generate human-readable base codes.
model SecuenciaCodigoBase {
  periodo       String @id
  ultimoNumero  Int    @map("ultimo_numero")

  @@map("secuencias_codigos_base")
}

/// A historical typification file is an append-only import descriptor, not a replacement for source records.
model ArchivoTipificaciones {
  id              String   @id @default(uuid()) @db.Uuid
  importacionId   String   @unique @map("importacion_id")
  baseId          String   @map("base_id") @db.Uuid
  nombreArchivo   String   @map("nombre_archivo")
  importadoEn     DateTime @default(now()) @map("importado_en")
  resumen         Json
  base            Base     @relation(fields: [baseId], references: [id], onDelete: Restrict)
  gestiones       GestionTipificacion[]
  archivoCanonico ArchivoCrmCanonico? @relation("ArchivoCrmCanonicoLegacy")

  @@index([baseId, importadoEn])
  @@map("archivos_tipificaciones")
}

/// Canonical identity for a CRM source file. Legacy ArchivoTipificaciones rows
/// remain intact; a later migration can link them here without rewriting them.
model ArchivoCrmCanonico {
  id                             String   @id @default(uuid()) @db.Uuid
  importacionId                   String   @unique @map("importacion_id")
  huellaContenido                 String?  @unique @map("huella_contenido")
  nombreArchivo                   String   @map("nombre_archivo")
  archivoTipificacionesLegacyId   String?  @unique @map("archivo_tipificaciones_legacy_id") @db.Uuid
  metadatos                       Json
  importadoEn                     DateTime @default(now()) @map("importado_en")
  archivoTipificacionesLegacy     ArchivoTipificaciones? @relation("ArchivoCrmCanonicoLegacy", fields: [archivoTipificacionesLegacyId], references: [id], onDelete: Restrict)
  asociaciones                    ArchivoCrmBase[]
  filas                           FilaArchivoCrm[]
  ejecucionesGlobales             EjecucionReciclajeGlobalArchivo[]

  @@index([importadoEn])
  @@map("archivos_crm_canonicos")
}

/// Per-original-base reconciliation snapshot for a reusable canonical CRM file.
model ArchivoCrmBase {
  id                    String              @id @default(uuid()) @db.Uuid
  archivoCrmId          String              @map("archivo_crm_id") @db.Uuid
  baseOriginalId        String              @map("base_original_id") @db.Uuid
  resumenConciliacion   Json?               @map("resumen_conciliacion")
  metadatos             Json
  asociadoEn            DateTime            @default(now()) @map("asociado_en")
  archivoCrm            ArchivoCrmCanonico  @relation(fields: [archivoCrmId], references: [id], onDelete: Restrict)
  baseOriginal          Base                @relation("ArchivoCrmBaseOriginal", fields: [baseOriginalId], references: [id], onDelete: Restrict)

  @@unique([archivoCrmId, baseOriginalId])
  @@index([baseOriginalId, asociadoEn])
  @@map("archivos_crm_bases")
}

/// Immutable source row of a canonical CRM file. It is independent from a
/// particular base so a file is parsed once and may be reconciled many times.
model FilaArchivoCrm {
  id                 String              @id @default(uuid()) @db.Uuid
  archivoCrmId       String              @map("archivo_crm_id") @db.Uuid
  hojaOrigen         String              @map("hoja_origen")
  numeroFilaOrigen   Int                 @map("numero_fila_origen")
  movilNormalizado   String?             @map("movil_normalizado")
  fechaGestion       DateTime?           @map("fecha_gestion") @db.Date
  tipificacionOriginal String?           @map("tipificacion_original")
  tipificacionNormalizada String?        @map("tipificacion_normalizada")
  ventaConfirmada    Boolean             @default(false) @map("venta_confirmada")
  evidenciaVenta     String?             @map("evidencia_venta")
  datosOriginales    Json                @map("datos_originales")
  metadatos          Json
  creadoEn           DateTime            @default(now()) @map("creado_en")
  archivoCrm         ArchivoCrmCanonico  @relation(fields: [archivoCrmId], references: [id], onDelete: Restrict)

  @@unique([archivoCrmId, hojaOrigen, numeroFilaOrigen])
  @@index([movilNormalizado])
  @@index([archivoCrmId, movilNormalizado])
  @@map("filas_archivos_crm")
}

/// Immutable, global recycling snapshot. It is deliberately separate from
/// EjecucionReciclaje, which remains the legacy single-base workflow.
model EjecucionReciclajeGlobal {
  id              String                         @id @default(uuid()) @db.Uuid
  operacionId     String                         @unique @map("operacion_id")
  usuarioId       String                         @map("usuario_id") @db.Uuid
  fechaEfectiva   DateTime                       @map("fecha_efectiva") @db.Date
  estado          EstadoEjecucionReciclajeGlobal @default(PREPARADA)
  versionReglas   String                         @map("version_reglas")
  criterios       Json
  resumen         Json?
  creadoEn        DateTime                       @default(now()) @map("creado_en")
  evaluadoEn      DateTime?                      @map("evaluado_en")
  baseRecicladaId String?                         @unique @map("base_reciclada_id") @db.Uuid
  generadoEn      DateTime?                       @map("generado_en")
  usuario         Usuario                        @relation(fields: [usuarioId], references: [id], onDelete: Restrict)
  archivos        EjecucionReciclajeGlobalArchivo[]
  bases           EjecucionReciclajeGlobalBase[]
  decisiones      DecisionEjecucionReciclajeGlobal[]
  baseReciclada   Base?                           @relation("BaseRecicladaGlobal", fields: [baseRecicladaId], references: [id], onDelete: Restrict)
  resultadosGeneracion ResultadoGeneracionReciclajeGlobal[]

  @@index([usuarioId, creadoEn])
  @@index([estado, creadoEn])
  @@map("ejecuciones_reciclajes_globales")
}

enum EstadoResultadoGeneracionReciclajeGlobal {
  INCLUIDO
  EXCLUIDO_CAMBIO
}

/// Immutable outcome of the final, transactional revalidation before a global
/// recycled base is generated. It never changes the RG-3 decision snapshot.
model ResultadoGeneracionReciclajeGlobal {
  id              String                                  @id @default(uuid()) @db.Uuid
  ejecucionId     String                                  @map("ejecucion_id") @db.Uuid
  movilNormalizado String                                 @map("movil_normalizado")
  estado          EstadoResultadoGeneracionReciclajeGlobal
  motivo          String
  procedencias    Json
  creadoEn        DateTime                                @default(now()) @map("creado_en")
  ejecucion       EjecucionReciclajeGlobal                @relation(fields: [ejecucionId], references: [id], onDelete: Restrict)

  @@unique([ejecucionId, movilNormalizado])
  @@index([ejecucionId, estado])
  @@map("resultados_generaciones_reciclajes_globales")
}

/// File membership and immutable source metadata for a global execution.
model EjecucionReciclajeGlobalArchivo {
  id              String                    @id @default(uuid()) @db.Uuid
  ejecucionId     String                    @map("ejecucion_id") @db.Uuid
  archivoCrmId    String                    @map("archivo_crm_id") @db.Uuid
  importacionId   String                    @map("importacion_id")
  nombreArchivo   String                    @map("nombre_archivo")
  metadatos       Json
  creadoEn        DateTime                  @default(now()) @map("creado_en")
  ejecucion       EjecucionReciclajeGlobal  @relation(fields: [ejecucionId], references: [id], onDelete: Restrict)
  archivoCrm      ArchivoCrmCanonico        @relation(fields: [archivoCrmId], references: [id], onDelete: Restrict)

  @@unique([ejecucionId, archivoCrmId])
  @@index([archivoCrmId])
  @@map("ejecuciones_reciclajes_globales_archivos")
}

/// Universe of valid ORIGINAL bases captured before the global evaluation.
model EjecucionReciclajeGlobalBase {
  id              String                    @id @default(uuid()) @db.Uuid
  ejecucionId     String                    @map("ejecucion_id") @db.Uuid
  baseOriginalId  String                    @map("base_original_id") @db.Uuid
  codigoBase      String                    @map("codigo_base")
  resumen         Json
  creadoEn        DateTime                  @default(now()) @map("creado_en")
  ejecucion       EjecucionReciclajeGlobal  @relation(fields: [ejecucionId], references: [id], onDelete: Restrict)
  baseOriginal    Base                      @relation(fields: [baseOriginalId], references: [id], onDelete: Restrict)

  @@unique([ejecucionId, baseOriginalId])
  @@index([baseOriginalId])
  @@map("ejecuciones_reciclajes_globales_bases")
}

/// One immutable decision per normalized mobile and global execution.
model DecisionEjecucionReciclajeGlobal {
  id              String                    @id @default(uuid()) @db.Uuid
  ejecucionId     String                    @map("ejecucion_id") @db.Uuid
  movilNormalizado String                   @map("movil_normalizado")
  decision        DecisionReciclajeGlobal
  motivo          String
  fuentes         Json
  creadoEn        DateTime                  @default(now()) @map("creado_en")
  ejecucion       EjecucionReciclajeGlobal  @relation(fields: [ejecucionId], references: [id], onDelete: Restrict)

  @@unique([ejecucionId, movilNormalizado])
  @@index([ejecucionId, decision])
  @@map("decisiones_ejecuciones_reciclajes_globales")
}

/// Future recycling executions must reference exactly one manually selected original base.
model EjecucionReciclaje {
  id              String                    @id @default(uuid()) @db.Uuid
  operacionId     String                    @unique @map("operacion_id")
  baseOriginalId  String                    @map("base_original_id") @db.Uuid
  baseRecicladaId String?                   @unique @map("base_reciclada_id") @db.Uuid
  usuarioId       String?                   @map("usuario_id") @db.Uuid
  fechaEfectiva   DateTime                  @map("fecha_efectiva") @db.Date
  estado          EstadoEjecucionReciclaje  @default(PREPARADA)
  metadatos       Json
  creadoEn        DateTime                  @default(now()) @map("creado_en")
  baseOriginal    Base                      @relation(fields: [baseOriginalId], references: [id], onDelete: Restrict)
  baseReciclada   Base?                     @relation("BaseReciclada", fields: [baseRecicladaId], references: [id], onDelete: Restrict)
  usuario         Usuario?                  @relation(fields: [usuarioId], references: [id], onDelete: Restrict)
  gestiones       GestionTipificacion[]
  resultados      ResultadoEjecucionReciclaje[]

  @@index([baseOriginalId, creadoEn])
  @@index([usuarioId, creadoEn])
  @@map("ejecuciones_reciclaje")
}

/// Immutable CRM management history. A later import never replaces an earlier row.
model GestionTipificacion {
  id                    String   @id @default(uuid()) @db.Uuid
  archivoId             String   @map("archivo_id") @db.Uuid
  ejecucionOrigenId     String?  @map("ejecucion_origen_id") @db.Uuid
  baseOriginalId        String   @map("base_original_id") @db.Uuid
  numeroFilaOrigen      Int      @map("numero_fila_origen")
  movilNormalizado      String   @map("movil_normalizado")
  fechaGestion          DateTime? @map("fecha_gestion") @db.Date
  tipificacionOriginal  String?  @map("tipificacion_original")
  tipificacionNormalizada String? @map("tipificacion_normalizada")
  ventaConfirmada       Boolean  @default(false) @map("venta_confirmada")
  evidenciaVenta        String?  @map("evidencia_venta")
  metadatos             Json
  creadoEn              DateTime @default(now()) @map("creado_en")
  archivo               ArchivoTipificaciones @relation(fields: [archivoId], references: [id], onDelete: Restrict)
  ejecucionOrigen       EjecucionReciclaje? @relation(fields: [ejecucionOrigenId], references: [id], onDelete: Restrict)
  baseOriginal          Base     @relation(fields: [baseOriginalId], references: [id], onDelete: Restrict)
  resultadosGanadores   ResultadoEjecucionReciclaje[] @relation("GestionGanadora")

  @@unique([archivoId, numeroFilaOrigen])
  @@index([baseOriginalId, movilNormalizado])
  @@index([baseOriginalId, fechaGestion])
  @@map("gestiones_tipificacion")
}

/// Snapshot of an execution. Re-evaluating later creates a new immutable set.
model ResultadoEjecucionReciclaje {
  id                    String   @id @default(uuid()) @db.Uuid
  ejecucionId           String   @map("ejecucion_id") @db.Uuid
  registroOriginalId    String   @map("registro_original_id") @db.Uuid
  gestionGanadoraId     String?  @map("gestion_ganadora_id") @db.Uuid
  estado                EstadoResultadoReciclaje
  motivo                String
  creadoEn              DateTime @default(now()) @map("creado_en")
  ejecucion             EjecucionReciclaje @relation(fields: [ejecucionId], references: [id], onDelete: Restrict)
  registroOriginal      Registro @relation(fields: [registroOriginalId], references: [id], onDelete: Restrict)
  gestionGanadora       GestionTipificacion? @relation("GestionGanadora", fields: [gestionGanadoraId], references: [id], onDelete: Restrict)

  @@unique([ejecucionId, registroOriginalId])
  @@index([ejecucionId, estado])
  @@map("resultados_ejecuciones_reciclaje")
}

model LoteRegistro {
  loteId              String    @map("lote_id") @db.Uuid
  registroId          String    @map("registro_id") @db.Uuid
  creadoEn            DateTime  @default(now()) @map("creado_en")
  lote                Lote      @relation(fields: [loteId], references: [id], onDelete: Cascade)
  registro            Registro  @relation(fields: [registroId], references: [id], onDelete: Cascade)

  @@id([loteId, registroId])
  @@index([registroId])
  @@map("lote_registros")
}

/// A durable commercial hold. Historical releases remain append-only records.
model ReservaComercial {
  id                    String                 @id @default(uuid()) @db.Uuid
  movilNormalizado      String                 @map("movil_normalizado")
  baseId                String                 @map("base_id") @db.Uuid
  loteId                String                 @map("lote_id") @db.Uuid
  campana               Campana
  usuarioId             String                 @map("usuario_id") @db.Uuid
  asesor                String?
  operacionId           String                 @unique @map("operacion_id")
  estado                EstadoReservaComercial @default(ACTIVA)
  creadoEn              DateTime               @default(now()) @map("creado_en")
  liberadaEn            DateTime?              @map("liberada_en")
  liberadaPorUsuarioId  String?                @map("liberada_por_usuario_id") @db.Uuid
  operacionLiberacionId String?                @unique @map("operacion_liberacion_id")
  metadatos             Json
  base                  Base                   @relation(fields: [baseId], references: [id], onDelete: Restrict)
  lote                  Lote                   @relation(fields: [loteId], references: [id], onDelete: Restrict)
  usuario               Usuario                @relation("ReservaCreador", fields: [usuarioId], references: [id], onDelete: Restrict)
  liberadaPor           Usuario?               @relation("ReservaLiberador", fields: [liberadaPorUsuarioId], references: [id], onDelete: Restrict)

  @@index([movilNormalizado, estado])
  @@index([baseId, creadoEn])
  @@index([loteId])
  @@map("reservas_comerciales")
}

/// Durable orchestration state. Progress is derived solely from confirmed blocks.
model TrabajoProcesamiento {
  id                 String                     @id @default(uuid()) @db.Uuid
  operacionId        String                     @unique @map("operacion_id")
  tipo               TipoTrabajoProcesamiento
  estado             EstadoTrabajoProcesamiento @default(PENDIENTE)
  usuarioId          String                     @map("usuario_id") @db.Uuid
  baseId             String?                    @map("base_id") @db.Uuid
  totalBloques       Int                        @default(0) @map("total_bloques")
  bloquesCompletados Int                        @default(0) @map("bloques_completados")
  bloquesFallidos    Int                        @default(0) @map("bloques_fallidos")
  progresoPorcentaje Int                        @default(0) @map("progreso_porcentaje")
  maxIntentos        Int                        @default(3) @map("max_intentos")
  checkpoint         Json?
  metadatos          Json
  codigoError        String?                    @map("codigo_error")
  mensajeError       String?                    @map("mensaje_error")
  creadoEn           DateTime                   @default(now()) @map("creado_en")
  iniciadoEn         DateTime?                  @map("iniciado_en")
  finalizadoEn       DateTime?                  @map("finalizado_en")
  actualizadoEn      DateTime                   @updatedAt @map("actualizado_en")
  usuario            Usuario                    @relation(fields: [usuarioId], references: [id], onDelete: Restrict)
  base               Base?                      @relation(fields: [baseId], references: [id], onDelete: Restrict)
  bloques            BloqueTrabajoProcesamiento[]
  archivos           ArchivoProcesamiento[]

  @@index([usuarioId, creadoEn])
  @@index([baseId, creadoEn])
  @@index([estado, creadoEn])
  @@map("trabajos_procesamiento")
}

/// A finite lease makes work recoverable after a worker interruption.
model BloqueTrabajoProcesamiento {
  id            String                     @id @default(uuid()) @db.Uuid
  trabajoId     String                     @map("trabajo_id") @db.Uuid
  numeroBloque  Int                        @map("numero_bloque")
  estado        EstadoTrabajoProcesamiento @default(PENDIENTE)
  intentos      Int                        @default(0)
  workerId      String?                    @map("worker_id")
  reclamadoEn   DateTime?                  @map("reclamado_en")
  leaseHasta    DateTime?                  @map("lease_hasta")
  checkpoint    Json?
  resumen       Json?
  codigoError   String?                    @map("codigo_error")
  mensajeError  String?                    @map("mensaje_error")
  completadoEn  DateTime?                  @map("completado_en")
  creadoEn      DateTime                   @default(now()) @map("creado_en")
  actualizadoEn DateTime                   @updatedAt @map("actualizado_en")
  trabajo       TrabajoProcesamiento       @relation(fields: [trabajoId], references: [id], onDelete: Restrict)

  @@unique([trabajoId, numeroBloque])
  @@index([trabajoId, estado, numeroBloque])
  @@index([estado, leaseHasta])
  @@map("bloques_trabajos_procesamiento")
}

/// Metadata/reference only; future private storage owns the original binary.
model ArchivoProcesamiento {
  id                String                 @id @default(uuid()) @db.Uuid
  trabajoId         String                 @map("trabajo_id") @db.Uuid
  nombreOriginal    String                 @map("nombre_original")
  tipoContenido     String?                @map("tipo_contenido")
  tamanoBytes       Int                    @map("tamano_bytes")
  huellaContenido   String                 @map("huella_contenido")
  referenciaPrivada String                 @map("referencia_privada")
  metadatos         Json
  creadoEn          DateTime               @default(now()) @map("creado_en")
  trabajo           TrabajoProcesamiento   @relation(fields: [trabajoId], references: [id], onDelete: Restrict)

  @@unique([trabajoId, huellaContenido])
  @@unique([referenciaPrivada])
  @@index([trabajoId, creadoEn])
  @@map("archivos_procesamiento")
}

model Usuario {
  id           String   @id @default(uuid()) @db.Uuid
  username     String   @unique
  passwordHash String   @map("password_hash")
  activo       Boolean  @default(true)
  createdAt    DateTime @default(now()) @map("created_at")
  eventosAuditoria EventoAuditoria[]
  exportaciones RegistroExportacion[]
  aprobacionesHlr AprobacionHlr[]
  ejecucionesReciclaje EjecucionReciclaje[]
  ejecucionesReciclajeGlobal EjecucionReciclajeGlobal[]
  importacionesVentas ImportacionVentas[]
  reservasCreadas ReservaComercial[] @relation("ReservaCreador")
  reservasLiberadas ReservaComercial[] @relation("ReservaLiberador")
  trabajosProcesamiento TrabajoProcesamiento[]
  basesArchivadas       Base[]     @relation("BaseArchivador")

  @@map("usuarios")
}

/// Append-only external commercial events. They are deliberately independent
/// of a particular Base: a confirmed sale must block the mobile everywhere.
model ImportacionVentas {
  id                String           @id @default(uuid()) @db.Uuid
  importacionId     String           @unique @map("importacion_id")
  huellaContenido   String           @unique @map("huella_contenido")
  usuarioId         String           @map("usuario_id") @db.Uuid
  nombreArchivo     String           @map("nombre_archivo")
  periodoDeclarado  String?          @map("periodo_declarado")
  resumen           Json
  creadoEn          DateTime         @default(now()) @map("creado_en")
  usuario           Usuario          @relation(fields: [usuarioId], references: [id], onDelete: Restrict)
  eventos           VentaExterna[]

  @@index([creadoEn])
  @@index([usuarioId, creadoEn])
  @@map("importaciones_ventas")
}

model VentaExterna {
  id                   String              @id @default(uuid()) @db.Uuid
  importacionId         String              @map("importacion_id") @db.Uuid
  numeroFilaOrigen      Int                 @map("numero_fila_origen")
  movilNormalizado      String?             @map("movil_normalizado")
  fechaVenta            DateTime?           @map("fecha_venta") @db.Date
  estado                EstadoVentaExterna
  estadoOriginal        String?             @map("estado_original")
  asesor                String?
  campana               String?
  resultadoConciliacion String              @map("resultado_conciliacion")
  metadatos             Json
  creadoEn              DateTime            @default(now()) @map("creado_en")
  importacion           ImportacionVentas   @relation(fields: [importacionId], references: [id], onDelete: Restrict)

  @@unique([importacionId, numeroFilaOrigen])
  @@index([movilNormalizado, estado])
  @@index([fechaVenta])
  @@map("ventas_externas")
}

model EventoAuditoria {
  id           String           @id @default(uuid()) @db.Uuid
  operacionId  String           @unique @map("operacion_id")
  creadoEn     DateTime         @default(now()) @map("creado_en")
  accion       AccionAuditoria
  usuarioId    String           @map("usuario_id") @db.Uuid
  baseId       String           @map("base_id") @db.Uuid
  loteId       String?          @map("lote_id") @db.Uuid
  campana      Campana?
  cantidad     Int?
  metadatos    Json
  usuario      Usuario          @relation(fields: [usuarioId], references: [id], onDelete: Restrict)
  base         Base             @relation(fields: [baseId], references: [id], onDelete: Restrict)

  @@index([baseId, creadoEn])
  @@index([usuarioId, creadoEn])
  @@index([campana, creadoEn])
  @@index([accion, creadoEn])
  @@map("eventos_auditoria")
}

model RegistroExportacion {
  id                    String             @id @default(uuid()) @db.Uuid
  operacionId           String             @unique @map("operacion_id")
  creadoEn              DateTime           @default(now()) @map("creado_en")
  usuarioId             String             @map("usuario_id") @db.Uuid
  baseId                String             @map("base_id") @db.Uuid
  loteId                String?            @map("lote_id") @db.Uuid
  numeroLote            Int?               @map("numero_lote")
  campana               Campana?
  tipo                  String
  estado                EstadoExportacion  @default(GENERADO)
  cantidad              Int
  filtros               Json
  metadatos             Json
  destinatario          String?
  descargaIniciadaEn    DateTime?          @map("descarga_iniciada_en")
  entregaConfirmadaEn   DateTime?          @map("entrega_confirmada_en")
  usuario               Usuario            @relation(fields: [usuarioId], references: [id], onDelete: Restrict)
  base                  Base               @relation(fields: [baseId], references: [id], onDelete: Restrict)

  @@index([baseId, creadoEn])
  @@index([campana, creadoEn])
  @@index([estado, creadoEn])
  @@map("registros_exportacion")
}

/// Shared, non-PII login throttle. `clave` is an HMAC of the normalized user.
model LimiteIntentosLogin {
  clave              String    @id
  intentos           Int       @default(0)
  ventanaIniciadaEn  DateTime  @map("ventana_iniciada_en")
  bloqueadoHasta     DateTime? @map("bloqueado_hasta")
  actualizadoEn      DateTime  @updatedAt @map("actualizado_en")

  @@index([bloqueadoHasta])
  @@map("limites_intentos_login")
}

enum EstadoConsultaHlr {
  PENDIENTE
  EN_CURSO
  EXITOSA
  INCIERTA
  FALLIDA
}

enum EstadoAprobacionHlr {
  PREPARADA
  APROBADA
  CANCELADA
  AGOTADA
}

enum TipoEventoHlr {
  COLA_PREPARADA
  RESERVA_CREADA
  RESULTADO_CACHEADO
  RESULTADO_RECIBIDO
  RESULTADO_INCIERTO
  RESULTADO_FALLIDO
}

/// Draft control plane for a future real HLR provider. It stores a keyed hash,
/// not the telephone number, and is not used until its migration is reviewed.
model ResultadoHlrReal {
  id              String   @id @default(uuid()) @db.Uuid
  proveedor       String
  huellaMovil     String   @map("huella_movil")
  resultado       Json
  consultadoEn    DateTime @default(now()) @map("consultado_en")
  vigenteHasta    DateTime @map("vigente_hasta")
  creadoEn        DateTime @default(now()) @map("creado_en")
  actualizadoEn   DateTime @updatedAt @map("actualizado_en")
  consultas       ConsultaHlr[]

  @@unique([proveedor, huellaMovil])
  @@index([proveedor, vigenteHasta])
  @@map("resultados_hlr_reales")
}

model AprobacionHlr {
  id                    String                @id @default(uuid()) @db.Uuid
  baseId                String                @map("base_id") @db.Uuid
  usuarioId             String                @map("usuario_id") @db.Uuid
  claveOperacion        String                @unique @map("clave_operacion")
  estado                EstadoAprobacionHlr   @default(PREPARADA)
  maximoConsultas       Int                   @map("maximo_consultas")
  presupuestoMaxCentimos Int                  @map("presupuesto_max_centimos")
  costeMaximoPorConsultaCentimos Int          @map("coste_maximo_por_consulta_centimos")
  consultasReservadas   Int                   @default(0) @map("consultas_reservadas")
  gastoReservadoCentimos Int                  @default(0) @map("gasto_reservado_centimos")
  aprobadoEn            DateTime?             @map("aprobado_en")
  creadoEn              DateTime              @default(now()) @map("creado_en")
  actualizadoEn         DateTime              @updatedAt @map("actualizado_en")
  base                  Base                  @relation(fields: [baseId], references: [id], onDelete: Cascade)
  usuario               Usuario               @relation(fields: [usuarioId], references: [id], onDelete: Restrict)
  destinos              ConsultaHlrRegistro[]

  @@index([baseId, estado])
  @@index([usuarioId])
  @@map("aprobaciones_hlr")
}

model ConsultaHlr {
  id                String             @id @default(uuid()) @db.Uuid
  proveedor         String
  huellaMovil       String             @map("huella_movil")
  claveIdempotencia String             @unique @map("clave_idempotencia")
  estado            EstadoConsultaHlr  @default(PENDIENTE)
  tokenReserva      String?            @unique @map("token_reserva")
  reservadaEn       DateTime?          @map("reservada_en")
  reservaExpiraEn   DateTime?          @map("reserva_expira_en")
  intentos          Int                @default(0)
  resultadoId       String?            @map("resultado_id") @db.Uuid
  creadoEn          DateTime           @default(now()) @map("creado_en")
  actualizadoEn     DateTime           @updatedAt @map("actualizado_en")
  resultado         ResultadoHlrReal?  @relation(fields: [resultadoId], references: [id], onDelete: Restrict)
  destinos          ConsultaHlrRegistro[]
  eventos           EventoConsultaHlr[]

  @@unique([proveedor, huellaMovil])
  @@index([estado, reservaExpiraEn])
  @@map("consultas_hlr")
}

model ConsultaHlrRegistro {
  consultaId     String         @map("consulta_id") @db.Uuid
  registroId     String         @map("registro_id") @db.Uuid
  baseId         String         @map("base_id") @db.Uuid
  aprobacionId   String         @map("aprobacion_id") @db.Uuid
  creadoEn       DateTime       @default(now()) @map("creado_en")
  consulta       ConsultaHlr    @relation(fields: [consultaId], references: [id], onDelete: Cascade)
  registro       Registro       @relation(fields: [registroId], references: [id], onDelete: Cascade)
  base           Base           @relation(fields: [baseId], references: [id], onDelete: Cascade)
  aprobacion     AprobacionHlr  @relation(fields: [aprobacionId], references: [id], onDelete: Cascade)

  @@id([consultaId, registroId])
  @@index([baseId])
  @@index([aprobacionId])
  @@map("consulta_hlr_registros")
}

model EventoConsultaHlr {
  id              String           @id @default(uuid()) @db.Uuid
  consultaId      String           @map("consulta_id") @db.Uuid
  tipo            TipoEventoHlr
  claveOperacion  String           @unique @map("clave_operacion")
  metadatos       Json
  creadoEn        DateTime         @default(now()) @map("creado_en")
  consulta        ConsultaHlr      @relation(fields: [consultaId], references: [id], onDelete: Cascade)

  @@index([consultaId, creadoEn])
  @@map("eventos_consulta_hlr")
}
